--- /dev/null
+++ b/internal/tofu/node_resource_forget_references_test.go
@@ -0,0 +1,41 @@
+// Copyright (c) The OpenTofu Authors
+// SPDX-License-Identifier: MPL-2.0
+
+package tofu
+
+import (
+	"testing"
+
+	"github.com/opentofu/opentofu/internal/configs/configschema"
+	"github.com/zclconf/go-cty/cty"
+)
+
+func TestNodeForgetResourceInstanceReferences(t *testing.T) {
+	module := testModuleInline(t, map[string]string{
+		"main.tf": `
+locals {
+  value = "retained"
+}
+resource "aws_instance" "retained" {
+  value = local.value
+  lifecycle {
+    destroy = false
+  }
+}
+`,
+	})
+	abstract := NewNodeAbstractResourceInstance(mustResourceInstanceAddr("aws_instance.retained"))
+	abstract.Config = module.Module.ManagedResources["aws_instance.retained"]
+	abstract.Schema = &configschema.Block{
+		Attributes: map[string]*configschema.Attribute{
+			"value": {Type: cty.String, Optional: true},
+		},
+	}
+	if len(abstract.References()) == 0 {
+		t.Fatal("fixture must reference the configuration local")
+	}
+	forget := &NodeForgetResourceInstance{NodeAbstractResourceInstance: abstract}
+	if refs := forget.References(); len(refs) != 0 {
+		t.Fatalf("forget must not evaluate resource arguments: %#v", refs)
+	}
+}
