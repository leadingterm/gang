+    # Download packed ZIPs through Bazel to use its repository cache.
+    # Archive checksums come from module pins.
+    for provider in providers.values():
+        source = provider["source"]
+        version = provider["version"]
+        name = source.split("/")[1]
+        platform = "{}_{}".format(ctx.attr.os, ctx.attr.arch)
+        key = "{}:{}/{}".format(source, version, platform)
+        sha256 = ctx.attr.mirror_sha256.get(key)
+        if not sha256:
+            fail("missing provider archive checksum for {}".format(key))
+        filename = "terraform-provider-{}_{}_{}.zip".format(name, version, platform)
+        ctx.download(
+            url = "https://github.com/opentofu/terraform-provider-{}/releases/download/v{}/{}".format(name, version, filename),
+            sha256 = sha256,
+            output = "mirror/registry.opentofu.org/{}/{}".format(source, filename),
+        )
 
     return
 
