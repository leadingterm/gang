# The memory hog, held until the go flag exists, so that its scope can be observed while it runs.
probe(
    name = "held_hog",
    controlled = True,
    exec_properties = MEMORY_HOG,
    script = JOURNAL + """
echo "$E2E_RUN hog started" > "$J"
while [ ! -s "$G" ]; do sleep 1; done
dd if=/dev/zero of=/dev/null bs=1G count=1 2>/dev/null
echo hogged=yes
""",
)

# Outgrows the soft limit of every reservation it gets and holds it, so each attempt ends only by a
# kill: attempt n holds one `dd` buffer of 96 MiB times 2^(n-1), as memory_grower does, above the
# soft limit of the reservation escalated n-1 times by 200 percent and below that reservation's
# cgroup ceiling. Appends a line per attempt to $E2E_ATTEMPTS first.
probe(
    name = "memory_escalation",
    controlled = True,
    exec_properties = MEMORY_HOG,
    script = """
echo "$E2E_ACTION ${GANG_MEMORY_KB:-0}" >> "$E2E_ATTEMPTS"
attempts=$(wc -l < "$E2E_ATTEMPTS")
size=100663296
i=1
while [ "$i" -lt "$attempts" ]; do size=$((size * 2)); i=$((i + 1)); done
dd if=/dev/zero bs="$size" count=1 2>/dev/null | sleep 300
echo "grown=yes"
""",
)

# Reserves 512 TiB of disk, more than any host has free. It would record an attempt if it ran.
probe(
    name = "disk_guarded",
    controlled = True,
    exec_properties = dict(EXEC_PROPERTIES, ISA = ISA, disk_kb = "549755813888"),
    script = """
echo "$E2E_ACTION ${GANG_MEMORY_KB:-0}" >> "$E2E_ATTEMPTS"
echo ran=yes
""",
)

# --- Neighbour-pressure probes ---
# Named independently so pool-OOM scenarios can reuse the same fixtures.
PRESSURE_VICTIM_BYTES = 201326592
PRESSURE_NEIGHBOUR_BYTES = 402653184
PRESSURE_CHURN_BYTES = 8388608

# The first reservation holds a dd buffer in a blocked FIFO write; the escalated
# and learned reservations run to completion without requiring another kill.
probe(
    name = "pressure_victim",
    controlled = True,
    exec_properties = dict(EXEC_PROPERTIES, ISA = ISA, cpu_count = str(CPU_COUNT), memory_kb = "65536"),
    script = JOURNAL + """
echo "$E2E_ACTION ${{GANG_MEMORY_KB:-0}}" >> "$E2E_ATTEMPTS" || exit 1
if [ "${{GANG_MEMORY_KB:-0}}" -lt 196608 ]; then
  mkfifo pressure-buffer pressure-wait || exit 1
  exec 4<> pressure-wait || exit 1
  sleep 300 < pressure-buffer &
  reader=$!
  dd if=/dev/zero of=pressure-buffer bs={size} count=1 2>/dev/null &
  writer=$!
  (
    C="$(dirname "$E2E_SIGNAL")/churn"
    while [ ! -s "$C" ] && [ ! -s "$G" ]; do read -r -t 0.05 <&4 || :; done
    while [ -s "$C" ] && [ ! -s "$G" ]; do dd if=/dev/zero of=/dev/null bs={churn} count=1 2>/dev/null || exit 1; done
  ) &
  churn=$!
  echo "$E2E_RUN pressure victim $$" > "$J" || exit 1
  while [ ! -s "$G" ]; do read -r -t 0.05 <&4 || :; done
  wait "$churn" || exit 1
  exec 4>&-
  exec 3< pressure-buffer || exit 1
  cat <&3 > /dev/null &
  drain=$!
  kill "$reader" 2>/dev/null || :
  exec 3<&-
  wait "$writer" || exit 1
  wait "$drain" || exit 1
else
  echo "$E2E_RUN pressure victim_retry $$" > "$J" || exit 1
  dd if=/dev/zero of=/dev/null bs={size} count=1 2>/dev/null || exit 1
fi
echo pressure=complete
""".format(size = PRESSURE_VICTIM_BYTES, churn = PRESSURE_CHURN_BYTES),
)

# The largest resident action is not the furthest above its reservation.
# The harness releases it only after observing the pressure kill.
probe(
    name = "pressure_neighbour",
    controlled = True,
    exec_properties = dict(EXEC_PROPERTIES, ISA = ISA, cpu_count = str(CPU_COUNT), memory_kb = "327680"),
    script = JOURNAL + """
echo "$E2E_ACTION ${{GANG_MEMORY_KB:-0}}" >> "$E2E_ATTEMPTS" || exit 1
mkfifo pressure-buffer pressure-wait || exit 1
exec 4<> pressure-wait || exit 1
sleep 300 < pressure-buffer &
reader=$!
dd if=/dev/zero of=pressure-buffer bs={size} count=1 2>/dev/null &
writer=$!
echo "$E2E_RUN pressure neighbour $$" > "$J" || exit 1
while [ ! -s "$G" ]; do read -r -t 0.05 <&4 || :; done
exec 4>&-
exec 3< pressure-buffer || exit 1
cat <&3 > /dev/null &
drain=$!
kill "$reader" 2>/dev/null || :
exec 3<&-
wait "$writer" || exit 1
wait "$drain" || exit 1
echo "$E2E_RUN pressure neighbour_done $$" > "$J" || exit 1
echo pressure=complete
""".format(size = PRESSURE_NEIGHBOUR_BYTES),
)
# --- End neighbour-pressure probes ---
