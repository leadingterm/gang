load(":config.bzl", "CPU_COUNT", "ISA", "LARGE_FLEET", "LARGE_MEMORY_KB", "MEMORY_KB", "REQUESTED_SANDBOX", "SIGNAL_COMMAND")
load(":rules.bzl", "input_root_probe", "probe")

# Namespaces of the action, as `readlink` prints them (`net:[4026531992]`); `unavailable` without /proc.
NAMESPACES = """
echo "net=$(readlink /proc/self/ns/net 2>/dev/null || echo unavailable)"
echo "mnt=$(readlink /proc/self/ns/mnt 2>/dev/null || echo unavailable)"
"""

# The action's directory name, the names and entries of its parent, grandparent and great-grandparent
# directories, and whether the working directory is writable. The worker's CAS must not be reachable
# through the action's parent directories. Under isolation the parent lists only the action's own
# directory, the grandparent only the parent, and the great-grandparent only the grandparent: the CAS
# sits beside the grandparent, so the probe lists three levels.
ISOLATION = NAMESPACES + """
echo "cwd=$(pwd)"
echo "cwd_name=$(basename "$PWD")"
echo "parent_name=$(basename "$(dirname "$PWD")")"
echo "parent_entries=$(ls -A .. | tr '\\n' ',')"
echo "grandparent_name=$(basename "$(dirname "$(dirname "$PWD")")")"
echo "grandparent_entries=$(ls -A ../.. | tr '\\n' ',')"
echo "great_grandparent_entries=$(ls -A ../../.. | tr '\\n' ',')"
if touch ./writable-probe 2>/dev/null; then echo cwd_writable=yes; else echo cwd_writable=no; fi
"""

probe(
    name = "isolated",
    script = ISOLATION,
)

probe(
    name = "network_requested",
    script = NAMESPACES,
    exec_properties = {
        "ISA": ISA,
        "network": "requested",
    },
)

probe(
    name = "pinned",
    script = "echo ran=yes",
    exec_properties = {"ISA": ISA},
)

# The placement probes: which fleet runs an action follows from its exec properties alone. Each
# is its own action, so a run's builds never serve one another from the remote cache.
probe(
    name = "fleet_unconstrained",
    script = NAMESPACES,
    exec_properties = {"ISA": ISA},
)

probe(
    name = "fleet_requested",
    script = NAMESPACES,
    exec_properties = {
        "ISA": ISA,
        "fleet": LARGE_FLEET,
    },
)

probe(
    name = "memory_requested",
    script = NAMESPACES,
    exec_properties = {
        "ISA": ISA,
        "memory_kb": str(LARGE_MEMORY_KB),
    },
)

probe(
    name = "sandbox_requested",
    script = NAMESPACES,
    exec_properties = {
        "ISA": ISA,
        "sandbox": REQUESTED_SANDBOX,
    },
)

# Built together, so that the first fleet is at its instance limit while the second still waits.
probe(
    name = "overflow_first",
    script = "echo ran=first",
    exec_properties = {"ISA": ISA},
)

probe(
    name = "overflow_second",
    script = "echo ran=second",
    exec_properties = {"ISA": ISA},
)

probe(
    name = "exit_three",
    script = "sh -c 'exit 3'",
)

# Tries to rewrite its input in place. Whether the rewrite reaches the cached file is up to the
# worker: with hard-linked inputs it does, unless `gang exec` breaks the links.
probe(
    name = "poison",
    srcs = ["payload.txt"],
    script = """
if chmod u+w payload.txt 2>/dev/null && echo POISONED >> payload.txt 2>/dev/null; then
  attempt=modified
else
  attempt=refused
fi
echo "attempt=$attempt"
""",
)

# Runs after `poison` (it consumes its report) and reads the same input.
probe(
    name = "victim",
    srcs = [
        "payload.txt",
        ":poison",
    ],
    script = """
if grep -q POISONED payload.txt; then poisoned=yes; else poisoned=no; fi
echo "poisoned=$poisoned"
""",
)

# Under `--experimental_sibling_repository_layout` (the harness passes it for this probe only),
# Bazel runs the action in a working directory below its input root, with the external input
# beside it: the action must read it directly and through a relative symlink.
input_root_probe(
    name = "input_root",
    shared = "@shared_input//:input",
    script = """
echo "shared_path=$E2E_SHARED"
echo "sibling=$(cat "$E2E_SHARED" 2>/dev/null)"
echo "symlink=$(cat "$E2E_LINK" 2>/dev/null)"
echo "sibling_links=$(stat -L -c %h "$E2E_SHARED" 2>/dev/null || echo unreadable)"
""",
)

LIMITS = {
    "ISA": ISA,
    "cpu_count": str(CPU_COUNT),
    "memory_kb": str(MEMORY_KB),
}

# Runs until the harness creates `release` in its working directory, and leaves behind a process
# whose command line carries a marker the harness looks for. The orphan runs `SIGNAL_COMMAND`, which
# the harness owns (crates/gang-e2e/src/hold.rs) and stages in config.bzl: once it runs, it writes
# one byte to the signal pipe, which tells the harness the orphan exists. The probe rule passes
# `E2E_SIGNAL` from the staged config.bzl to the action as an environment variable.
probe(
    name = "hold",
    exec_properties = LIMITS,
    script = """
marker=e2e-orphan
sh -c "{signal}; sleep 3600; : $marker-$E2E_SALT" &
while [ ! -e release ]; do sleep 1; done
echo released=yes
""".format(signal = SIGNAL_COMMAND),
)

# Limits of the memory and disk probes, in KiB, as their platform properties. They live here rather
# than in config.bzl, which the harness overwrites in each staged copy.
MEMORY_HOG = {
    "ISA": ISA,
    "cpu_count": str(CPU_COUNT),
    "memory_kb": "32768",
}

# Allocates one 1 GiB buffer at once against a hard ceiling of twice its 32 MiB reservation. The
# allocation outruns NativeLink's 250 ms sampling window, so this check proves the cgroup backstop:
# the kernel kills it at `memory.max` before NativeLink's two-sample soft rule can act.
probe(
    name = "memory_hog",
    exec_properties = MEMORY_HOG,
    script = """
dd if=/dev/zero of=/dev/null bs=1G count=1 2>/dev/null
echo hogged=yes
""",
)

# Holds 48 MiB, above the 38.4 MiB soft limit of its 32 MiB reservation and below the 64 MiB cgroup
# ceiling, so only NativeLink can end the first attempt, which holds it until it is killed. The
# requeued attempt, with the reservation doubled to 64 MiB, completes at once. `dd` reads the whole
# size into one buffer and blocks writing it to `sleep`, which never reads, so the footprint is that
# buffer however the processes are scheduled. Each attempt appends a line to $E2E_ATTEMPTS, a host
# path, before it grows.
probe(
    name = "memory_grower",
    exec_properties = MEMORY_HOG,
    script = """
echo attempt >> "$E2E_ATTEMPTS"
attempts=$(wc -l < "$E2E_ATTEMPTS")
if [ "$attempts" -eq 1 ]; then hold=300; else hold=0; fi
dd if=/dev/zero bs=50331648 count=1 2>/dev/null | sleep "$hold"
echo "grown=yes"
""",
)

# Writes 64 MiB under its working directory against a disk reservation of 4 MiB, then waits. Only
# the worker's disk kill ends the wait; the Bazel watchdog bounds a deployment that never kills it.
probe(
    name = "disk_hog",
    exec_properties = {
        "ISA": ISA,
        "disk_kb": "4096",
    },
    script = """
head -c 67108864 /dev/zero > hog.bin
sleep 300
echo hogged=yes
""",
)

# Appends 256 KiB a second for 30 seconds to its own file, reads it back, and reports whether the
# file holds exactly 30 * 256 KiB. Its 64 MiB reservation is far above what it writes.
probe(
    name = "disk_neighbour",
    exec_properties = {
        "ISA": ISA,
        "disk_kb": "65536",
    },
    script = """
i=0
while [ $i -lt 30 ]; do
  head -c 262144 /dev/zero >> neighbour.bin
  i=$((i+1))
  sleep 1
done
size=$(wc -c < neighbour.bin | tr -d ' ')
if [ "$size" -eq 7864320 ]; then neighbour=ok; else neighbour=bad; fi
echo "neighbour=$neighbour"
""",
)
# The execution probes talk to the harness through two paths beside the hold signal: the journal, a named pipe
# they write lines to, and the go flag, a file whose existence releases them. Both are reachable under bwrap,
# whose only host mounts are the working directory and the read-only binds. Every journal line starts with
# $E2E_RUN and a space, so the harness reads only the lines of the held build it observes.
JOURNAL = 'J="$(dirname "$E2E_SIGNAL")/journal"; G="$(dirname "$E2E_SIGNAL")/go"\n'

# Starts a background child that ignores SIGTERM and carries a marker, then waits forever: only the action
# timeout ends it.
probe(
    name = "timeout_child",
    script = JOURNAL + """
sh -c 'trap "" TERM; echo "$E2E_RUN child started" > "$2"; while :; do sleep 1; done' sh e2e-timeout-child "$J" &
while :; do sleep 1; done
""",
)

# Waits forever; on SIGTERM it reports to the journal, finishes a one-second cleanup, and exits 0. The first
# line names its TMPDIR, the per-action directory of the noop sandbox.
probe(
    name = "term_trap",
    script = JOURNAL + """
trap 'echo "$E2E_RUN trap term" > "$J"; sleep 1; echo "$E2E_RUN trap clean" > "$J"; exit 0' TERM
echo "$E2E_RUN trap started ${TMPDIR:-none}" > "$J"
while :; do sleep 1 & wait $!; done
""",
)

# Waits forever and ignores SIGTERM: it reports the signal, then reports again after at least one more whole
# second, which only a process that outlives SIGTERM can do.
probe(
    name = "term_ignorer",
    script = JOURNAL + """
termed=0
trap 'termed=1; echo "$E2E_RUN ignore term" > "$J"' TERM
echo "$E2E_RUN ignore started" > "$J"
seconds=0
while :; do
  sleep 1 & wait $!
  if [ "$termed" -eq 1 ]; then
    seconds=$((seconds + 1))
    if [ "$seconds" -eq 2 ]; then echo "$E2E_RUN ignore survived" > "$J"; fi
  fi
done
""",
)

probe(
    name = "self_kill",
    script = "kill -KILL $$",
)

probe(
    name = "self_term",
    script = "kill -TERM $$",
)

# Records what the sandbox exposes: the names of its environment variables, the entries of /tmp other than the
# directories bwrap creates to hold its binds (the working directory and the read-only binds may live under
# /tmp on the host), its filesystem type, whether each mount point can be touched (`erofs` when the mount is
# read-only), and whether its working directory is writable.
probe(
    name = "sandbox_contract",
    script = """
echo "env_names=$(env -0 | tr '\\n\\0' ' \\n' | cut -d= -f1 | tr '\\n' ',')"
entries=""
for entry in $(ls -A /tmp); do
  if ! cut -d' ' -f5 /proc/self/mountinfo | grep -q "^/tmp/$entry\\(/\\|$\\)"; then entries="$entries$entry,"; fi
done
echo "tmp_entries=$entries"
echo "tmp_fs=$(stat -f -c %T /tmp)"
cut -d' ' -f5 /proc/self/mountinfo | sort -u | while read -r point; do
  if out=$(touch -c "$point" 2>&1); then state=ok
  else case "$out" in *"Read-only file system"*) state=erofs ;; *) state=other ;; esac
  fi
  echo "mount:$point=$state"
done
if touch ./writable-probe 2>/dev/null; then echo cwd_writable=yes; else echo cwd_writable=no; fi
""",
)

# Runs a dynamically linked glibc program, as the toolchains Bazel downloads are (rules_rust's rustc and
# cargo, prebuilt tools): it starts only where the sandbox provides an ELF interpreter at the standard path.
probe(
    name = "glibc_tool",
    srcs = ["glibc-tool"],
    script = """
if out=$(./glibc-tool 2>&1); then echo "glibc_tool=ran"
else echo "glibc_tool=failed: $(printf '%s' "$out" | tr '\\n' ' ')"
fi
""",
)

# Runs fhs-tools.sh with Bazel's strict action PATH (--incompatible_strict_action_env): it starts only where
# the sandbox provides /usr/bin/env, and finishes only where /bin and /usr/bin hold bash, sh and the tools.
probe(
    name = "fhs_tools",
    srcs = ["fhs-tools.sh"],
    path = "/bin:/usr/bin:/usr/local/bin",
    script = """
if out=$(./fhs-tools.sh 2>&1); then echo "fhs_tools=$out"
else echo "fhs_tools=failed: ${out//$'\\n'/ }"
fi
""",
)

# Leaves behind a process in its own process group, marked and named in the journal, then waits for the go
# flag. Once the flag exists it succeeds at once, so a requeued attempt leaves nothing behind.
probe(
    name = "stray",
    script = JOURNAL + """
if [ -e "$G" ]; then echo stray=skipped; exit 0; fi
set -m
sh -c 'echo "$E2E_RUN stray $$" > "$2"; while :; do sleep 1; done' sh e2e-stray "$J" &
set +m
while [ ! -e "$G" ]; do sleep 1; done
echo stray=released
""",
)

# Reports to the journal, then waits for the go flag.
probe(
    name = "held_release",
    script = JOURNAL + """
echo "$E2E_RUN held started" > "$J"
while [ ! -e "$G" ]; do sleep 1; done
echo held=released
""",
)

# The memory hog, held until the go flag exists, so that its scope can be observed while it runs.
probe(
    name = "held_hog",
    exec_properties = MEMORY_HOG,
    script = JOURNAL + """
echo "$E2E_RUN hog started" > "$J"
while [ ! -e "$G" ]; do sleep 1; done
dd if=/dev/zero of=/dev/null bs=1G count=1 2>/dev/null
echo hogged=yes
""",
)

# Outgrows the soft limit of every reservation it gets and holds it, so each attempt ends only by a
# kill: attempt n holds one `dd` buffer of 48 MiB times 2^(n-1), as memory_grower does, above the
# soft limit of the reservation escalated n-1 times by 200 percent and below that reservation's
# cgroup ceiling. Appends a line per attempt to $E2E_ATTEMPTS first.
probe(
    name = "memory_escalation",
    exec_properties = MEMORY_HOG,
    script = """
echo attempt >> "$E2E_ATTEMPTS"
attempts=$(wc -l < "$E2E_ATTEMPTS")
size=50331648
i=1
while [ "$i" -lt "$attempts" ]; do size=$((size * 2)); i=$((i + 1)); done
dd if=/dev/zero bs="$size" count=1 2>/dev/null | sleep 300
echo "grown=yes"
""",
)

# Reserves 512 TiB of disk, more than any host has free. It would record an attempt if it ran.
probe(
    name = "disk_guarded",
    exec_properties = {
        "ISA": ISA,
        "disk_kb": "549755813888",
    },
    script = """
echo attempt >> "$E2E_ATTEMPTS"
echo ran=yes
""",
)
