# Records environment names, tmpfs contents, mount flags, and working-directory writability.
probe(
    name = "sandbox_contract",
    srcs = ["action-environment-probe", "action-environment-postgresql.tar.gz"],
    script = """
echo "env_names=$(env -0 | tr '\\n\\0' ' \\n' | cut -d= -f1 | tr '\\n' ',')"
entries=""
for entry in $(ls -A /tmp); do
  if ! cut -d' ' -f5 /proc/self/mountinfo | grep -q "^/tmp/$entry\\(/\\|$\\)"; then entries="$entries$entry,"; fi
done
echo "tmp_entries=$entries"
echo "tmp_fs=$(stat -f -c %T /tmp)"
cut -d' ' -f5 /proc/self/mountinfo | sort -u | while read -r point; do
  options=$(awk -v p="$point" '$5 == p { print $6 }' /proc/self/mountinfo)
  case ",$options," in *,ro,*) state=erofs ;; *) state=other ;; esac
  echo "mount:$point=$state"
done
if touch ./writable-probe 2>/dev/null; then echo cwd_writable=yes; else echo cwd_writable=no; fi
uid=$(id -u)
gid=$(id -g)
if [ "$uid" = 1000 ] && [ "$gid" = 1000 ] &&
   [ "$(id -un 2>/dev/null)" = builder ] && [ "$(id -gn 2>/dev/null)" = builder ] &&
   [ "$(awk -F: -v uid="$uid" '$3 == uid && $1 == "builder" { ok++ } END { print ok }' /etc/passwd)" = 1 ] &&
   [ "$(awk -F: -v gid="$gid" '$3 == gid && $1 == "builder" { ok++ } END { print ok }' /etc/group)" = 1 ]; then
  echo identity=yes
else echo identity=no; fi
if [ "$(cat /etc/nsswitch.conf 2>/dev/null | tr -s ' ')" = "$(printf 'passwd: files\\ngroup: files\\nhosts: files dns')" ]; then echo nss=yes; else echo nss=no; fi
if [ "$(find /etc -mindepth 1 | sort | tr '\\n' ',')" = "/etc/group,/etc/hosts,/etc/nsswitch.conf,/etc/passwd,/etc/pki,/etc/pki/tls,/etc/pki/tls/certs,/etc/pki/tls/certs/ca-bundle.crt,/etc/resolv.conf,/etc/ssl,/etc/ssl/cert.pem,/etc/ssl/certs,/etc/ssl/certs/ca-certificates.crt," ]; then echo etc_contents=yes; else echo etc_contents=no; fi
readonly=yes
[ ! -s /etc/resolv.conf ] || readonly=no
[ ! -L /etc/resolv.conf ] || readonly=no
if (: >> /etc/resolv.conf) 2>/dev/null; then readonly=no; fi
for file in /etc/passwd /etc/group /etc/hosts /etc/nsswitch.conf /etc/resolv.conf /etc/ssl/certs/ca-certificates.crt /etc/ssl/cert.pem /etc/pki/tls/certs/ca-bundle.crt; do
  [ -f "$file" ] || readonly=no
done
for point in / /etc /usr; do
  options=$(awk -v p="$point" '$5 == p { print $6 }' /proc/self/mountinfo)
  case ",$options," in *,ro,*) ;; *) readonly=no ;; esac
done
echo "identity_roots_readonly=$readonly"
if out=$(./action-environment-probe --gang-e2e-action-environment-probe roots 2>&1); then echo roots=yes; else echo "roots=failed: $(printf '%s' "$out" | tr '\\n' ' ')"; fi
if out=$(SSL_CERT_FILE=/missing-ca-file SSL_CERT_DIR=/missing-ca-dir ./action-environment-probe --gang-e2e-action-environment-probe roots 2>&1); then echo roots_override=no; else echo roots_override=yes; fi
if out=$(./action-environment-probe --gang-e2e-action-environment-probe postgres action-environment-postgresql.tar.gz 2>&1); then echo postgres=yes; else echo "postgres=failed: $(printf '%s' "$out" | tr '\\n' ' ')"; fi
""",
)

# Runs a dynamically linked glibc program, as the toolchains Bazel downloads are (rules_rust's rustc and
# cargo, prebuilt tools): it starts only where the sandbox provides an ELF interpreter at the standard path.
probe(
    name = "glibc_tool",
    srcs = ["glibc-tool"],
    script = """
if out=$(./glibc-tool 2>&1); then echo "glibc_tool=ran"
else echo "glibc_tool=failed: $(printf '%s' "$out" | tr '\\n' ' ')"
fi
""",
)

# Runs fhs-tools.sh with Bazel's strict action PATH (--incompatible_strict_action_env): it starts only where
# the sandbox provides /usr/bin/env, and finishes only where /bin and /usr/bin hold bash, sh and the tools.
probe(
    name = "fhs_tools",
    srcs = ["fhs-tools.sh"],
    path = "/bin:/usr/bin",
    script = """
if out=$(./fhs-tools.sh 2>&1); then echo "fhs_tools=$out"
else echo "fhs_tools=failed: ${out//$'\\n'/ }"
fi
""",
)

# Leaves a marked process in its own process group. A nonempty go flag releases later attempts.
probe(
    name = "stray",
    controlled = True,
    script = JOURNAL + """
if [ -s "$G" ]; then echo stray=skipped; exit 0; fi
set -m
sh -c 'echo "$E2E_RUN stray $$" > "$2"; while :; do sleep 1; done' sh e2e-stray "$J" &
set +m
while [ ! -s "$G" ]; do sleep 1; done
echo stray=released
""",
)

# Reports to the journal, then waits for the go flag.
probe(
    name = "held_release",
    controlled = True,
    script = JOURNAL + """
echo "$E2E_RUN held started" > "$J"
while [ ! -s "$G" ]; do sleep 1; done
echo held=released
""",
)
# Independent held actions for controller failover. The worker is identified by walking the
# process ancestry on the Local Mode host, and each attempt records both ends of its interval.
CONTROLLER_LOSS = """
script=$(cat <<'GANG_CONTROLLER_LOSS'
J="$(dirname "$E2E_SIGNAL")/journal"
G="$(dirname "$E2E_SIGNAL")/go"
witness=$E2E_LOCK_WITNESS
worker=$PPID
while [ "$worker" -gt 1 ]; do
  exec 3< "/proc/$worker/cmdline"
  IFS= read -r -d '' program <&3 || exit 1
  IFS= read -r -d '' subcommand <&3 || subcommand=
  exec 3<&-
  [ "$subcommand" = worker ] && break
  parent=
  while read -r key value rest; do
    if [ "$key" = "PPid:" ]; then parent=$value; break; fi
  done < "/proc/$worker/status"
  [ -n "$parent" ] || exit 1
  worker=$parent
done
[ "$worker" -gt 1 ] || exit 1
attempt=$$
echo "$E2E_RUN loss start $E2E_ACTION $worker $attempt $(date +%s%N) $witness" > "$J"
while [ ! -s "$G" ]; do sleep 1; done
echo "$E2E_RUN loss end $E2E_ACTION $worker $attempt $(date +%s%N)" > "$J"
echo held=released
GANG_CONTROLLER_LOSS
)
./action-environment-probe --gang-e2e-action-environment-probe lock "$(dirname "$E2E_SIGNAL")/$E2E_RUN-$E2E_ACTION.lock" "$0" "$script"
"""
probe(name = "controller_loss_0", srcs = ["action-environment-probe"], script = CONTROLLER_LOSS, controlled = True, exec_properties = LIMITS)
probe(name = "controller_loss_1", srcs = ["action-environment-probe"], script = CONTROLLER_LOSS, controlled = True, exec_properties = LIMITS)
probe(name = "controller_loss_2", srcs = ["action-environment-probe"], script = CONTROLLER_LOSS, controlled = True, exec_properties = LIMITS)
