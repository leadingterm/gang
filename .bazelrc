common --enable_bzlmod
common --enable_platform_specific_config
common --lockfile_mode=error
common --repo_env=ASPECT_TOOLS_TELEMETRY=-all
# Repository rules see the client environment; --action_env (the devShell's pinned PATH) is for actions only.
common --incompatible_repo_env_ignores_action_env

build --incompatible_strict_action_env
build:linux --platforms=//bazel/platforms:linux_musl
build:macos --repo_env=CC=/usr/bin/clang
build:macos --repo_env=CXX=/usr/bin/clang++

build --@rules_rust//rust/settings:clippy_flags=-Dwarnings
build --@rules_rust//rust/settings:clippy.toml=//:clippy.toml

test --test_output=errors
test --local_test_jobs=HOST_CPUS*.25

# `bazel coverage`: instrument the workspace crates, test targets included, into one lcov report.
# Test helper binaries are named `fake_*` and stay uninstrumented because the
# profiler runtime changes the environment and files they report on.
coverage --instrument_test_targets
coverage --instrumentation_filter=^//crates[/:],-^//crates/[^:]+:fake_
coverage --combined_report=lcov

# GitHub-hosted runners pass --config=ci. Peak RSS of a clean -c opt //:gang build on 4 CPUs: the
# aws-sdk-ec2 crate alone 10.1 GiB, every other action 2.6 GiB or less, the Bazel server 1.5 GiB.
# Two local actions at a time keep the build under 14 GiB, inside the 16 GB runners.
build:ci --local_resources=cpu=2

# hermetic_cc_toolchain's zig keeps the C runtimes it compiles (musl, compiler-rt, libunwind) in its
# cache directory. Actions run without HOME, so that directory defaults to /tmp/zig-cache, which the
# sandbox's hermetic /tmp empties for every action: each C compile and link rebuilt the runtimes.
# CI gives zig one persistent cache directory, writable inside the sandbox; setup-ci creates it.
build:ci --repo_env=HERMETIC_CC_TOOLCHAIN_CACHE_PREFIX=/var/tmp/zig-cache
build:ci --sandbox_writable_path=/var/tmp/zig-cache

try-import %workspace%/.bazelrc.local
