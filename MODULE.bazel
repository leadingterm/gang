# Remove archive package boundaries so the generated root filegroup sees every source.
UPGRADE_SOURCE_BUILD = """
exports_files(["Cargo.toml"])
filegroup(
    name = "sources",
    srcs = glob(["infra/**", "configs/**"]) + ["Cargo.toml"],
    visibility = ["//visibility:public"],
)
"""

UPGRADE_SOURCE_PATCH = "find infra configs -type f \\( -name BUILD -o -name BUILD.bazel \\) -delete"

http_archive(
    name = "gang_v035_source",
    build_file_content = UPGRADE_SOURCE_BUILD,
    dev_dependency = True,
    patch_cmds = [UPGRADE_SOURCE_PATCH],
    sha256 = "ca92feffbca1ba24adcf6867afa29e7f90a05b7e0cce0d0f7fdde6bf0579fe70",
    strip_prefix = "gang-0.3.5",
    type = "tar.gz",
    urls = ["https://codeload.github.com/leadingterm/gang/tar.gz/refs/tags/v0.3.5"],
)

http_archive(
    name = "gang_v037_source",
