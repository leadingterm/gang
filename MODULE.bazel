"""Gang's hermetic build graph: Rust and the dashboard UI."""

module(
    name = "gang",
)

# Cargo.toml's [workspace.package] version is Gang's version; Bazel reads it from there (bazel/version).
gang_version = use_extension("//bazel/version:extensions.bzl", "workspace_version")
use_repo(gang_version, "gang_version")

action_environment_repository = use_repo_rule("//bazel/action_environment:repository.bzl", "action_environment_repository")

action_environment_repository(name = "gang_env")

RUST_VERSION = "1.97.1"

OPENTOFU_VERSION = "1.13.9"

# zig's musl supplies the C runtime, so rustc must not add its own self-contained copy (duplicate _start).
MUSL_RUSTC_FLAGS = ["-Clink-self-contained=no"]

MUSL_RUSTC_FLAGS_BY_TRIPLE = {
    "x86_64-unknown-linux-musl": MUSL_RUSTC_FLAGS,
    "aarch64-unknown-linux-musl": MUSL_RUSTC_FLAGS,
}

LINUX_X86_64_MUSL_COMPATIBLE = [
    "@platforms//cpu:x86_64",
    "@platforms//os:linux",
    "@zig_sdk//libc:musl",
]

LINUX_AARCH64_MUSL_COMPATIBLE = [
    "@platforms//cpu:aarch64",
    "@platforms//os:linux",
    "@zig_sdk//libc:musl",
]

bazel_dep(name = "rules_rust", version = "0.72.0")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "hermetic_cc_toolchain", version = "4.3.0")
