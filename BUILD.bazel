load("@aspect_gazelle_prebuilt//:def.bzl", "aspect_gazelle")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//bazel/rust:defs.bzl", "workspace_rust_source_set")

aspect_gazelle(
    name = "gazelle",
    extensions = ["//bazel/gazelle:rust.axl"],
    languages = [],
    with_check = True,
)

alias(
    name = "gang",
    actual = "//crates/gang-main:gang",
    visibility = ["//visibility:public"],
)

exports_files([
    "Cargo.Bazel.lock",
    "Cargo.lock",
    "Cargo.toml",
    "MODULE.bazel",
    "clippy.toml",
    "e2e/sample/BUILD.bazel",
    "tools/e2e-gate.sh",
])

sh_test(
    name = "check-opentofu-tests_test",
    size = "small",
    timeout = "short",
    srcs = ["tools/check-opentofu-tests_test.sh"],
    data = ["tools/check-opentofu-tests.sh"],
    env = {"GUARD_SCRIPT": "$(rootpath tools/check-opentofu-tests.sh)"},
)

sh_test(
    name = "login_action_test",
    size = "small",
    timeout = "short",
    srcs = [".github/actions/login/login_test.sh"],
    data = [".github/actions/login/action.yml"],
    env = {"LOGIN_ACTION": "$(rootpath .github/actions/login/action.yml)"},
)

workspace_rust_source_set(
    name = "rust_workspace_sources",
    packages = [
        "bazel/architecture",
        "bazel/opentofu/runner",
        "crates/gang-authn",
        "crates/gang-aws",
        "crates/gang-aws-sdk",
        "crates/gang-bindings",
        "crates/gang-bwrap",
        "crates/gang-cas",
        "crates/gang-cgroup",
        "crates/gang-client",
        "crates/gang-clock",
        "crates/gang-config",
        "crates/gang-deploy",
        "crates/gang-dynamodb",
        "crates/gang-e2e",
        "crates/gang-embed",
        "crates/gang-engine",
        "crates/gang-exec",
        "crates/gang-insight",
        "crates/gang-local",
        "crates/gang-macros",
        "crates/gang-main",
        "crates/gang-mtls",
        "crates/gang-nativelink",
        "crates/gang-noop",
        "crates/gang-oidc",
        "crates/gang-os",
        "crates/gang-postgres",
        "crates/gang-protogen",
        "crates/gang-reapi",
        "crates/gang-reconciler",
        "crates/gang-scheduler",
        "crates/gang-server",
        "crates/gang-spi",
        "crates/gang-sqlite",
        "crates/gang-state",
        "crates/gang-testkit",
        "crates/gang-tls",
        "crates/gang-types",
        "crates/gang-ui",
        "crates/gang-wire",
        "crates/gang-worker",
    ],
)
