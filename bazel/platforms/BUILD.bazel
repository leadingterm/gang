load("@gang_env//:defs.bzl", "EXEC_PROPERTIES")

# The Linux target platform of every Gang build: the host's OS and CPU with the musl libc, so that
# every Linux binary is static and never runs the dynamic loader.
platform(
    name = "linux_musl",
    constraint_values = ["@zig_sdk//libc:musl"],
    exec_properties = EXEC_PROPERTIES,
    parents = ["@platforms//host"],
    visibility = ["//visibility:public"],
)

# Host platforms used to select pinned binaries.
config_setting(
    name = "linux_x86_64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    visibility = ["//visibility:public"],
)

config_setting(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
    visibility = ["//visibility:public"],
)

config_setting(
    name = "macos_arm64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:aarch64",
    ],
    visibility = ["//visibility:public"],
)

# Linux ARM remote execution is independent of the client and target CPU.
platform(
    name = "linux_arm64_exec",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
    exec_properties = dict(
        EXEC_PROPERTIES,
        ISA = "aarch64",
    ),
    visibility = ["//visibility:public"],
)
