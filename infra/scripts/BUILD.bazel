load("@rules_shell//shell:sh_test.bzl", "sh_test")

sh_test(
    name = "install-gang_test",
    srcs = ["install-gang_test.sh"],
    data = ["install-gang.sh"],
    env = {"INSTALL_GANG": "$(rootpath install-gang.sh)"},
)

sh_test(
    name = "reviewed-plan_test",
    size = "small",
    timeout = "short",
    srcs = ["reviewed-plan_test.sh"],
    data = [
        "reviewed-plan.sh",
        "@import_test_tools//:jq",
    ],
    env = {
        "REVIEWED_PLAN": "$(rootpath reviewed-plan.sh)",
        "REVIEWED_JQ": "$(rootpath @import_test_tools//:jq)",
    },
)

