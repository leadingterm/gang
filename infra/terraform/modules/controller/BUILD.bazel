load("//bazel/opentofu:defs.bzl", "opentofu_contract_test")

exports_files(
    ["lifecycle-hook.json"],
    visibility = ["//crates/gang-aws:__pkg__"],
)

opentofu_contract_test(
    name = "controller_contract",
    deps = [
        "//infra/terraform/modules/instance-role:sources",
        "//infra/terraform/modules/load-balancer:sources",
    ],
)

opentofu_contract_test(
    name = "controller_group_contract",
    test_file = "tests/controller_group.tftest.hcl",
    deps = [
        "//infra/terraform/modules/instance-role:sources",
        "//infra/terraform/modules/load-balancer:sources",
    ],
)

opentofu_contract_test(
    name = "controller_lifecycle_transition_contract",
