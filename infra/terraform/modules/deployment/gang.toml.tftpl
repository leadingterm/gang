poll_interval = ${jsonencode(gang_settings.poll_interval)}
client_action_timeout = ${jsonencode(gang_settings.client_action_timeout)}
default_isa = ${jsonencode(default_isa)}
listen = ${jsonencode("0.0.0.0:${public_port}")}
%{ if health_port != null ~}
health_listen = ${jsonencode("0.0.0.0:${health_port}")}
%{ endif ~}
worker_listen = ${jsonencode("0.0.0.0:${worker_port}")}
worker_endpoint = ${jsonencode(worker_endpoint)}
endpoint = ${jsonencode(endpoint)}
%{ for f in fleets }

[[fleets]]
name = ${jsonencode(f.name)}
isa = ${jsonencode(f.isa)}
sandbox = ${jsonencode(f.sandbox)}
action_environment = ${jsonencode(f.action_environment)}
min_instances = ${f.min_instances}
max_instances = ${f.max_instances}
vcpus_per_instance = ${f.vcpus_per_instance}
memory_per_instance = ${jsonencode(f.memory_per_instance)}
disk_per_instance = ${jsonencode(f.disk_per_instance)}
target_actions_per_instance = ${f.target_actions_per_instance}
idle_timeout = ${jsonencode(f.idle_timeout)}
max_drain_wait = ${jsonencode(f.max_drain_wait)}
boot_grace = ${jsonencode(f.boot_grace)}
[fleets.actions]
grants = ${jsonencode(sort(tolist(f.actions.grants)))}

[fleets.actions.resources]
%{ if f.actions.resources.cpu_count != null ~}
cpu_count = ${f.actions.resources.cpu_count}
%{ endif ~}
%{ if f.actions.resources.memory != null ~}
memory = ${jsonencode(f.actions.resources.memory)}
%{ endif ~}
%{ if f.actions.resources.disk != null ~}
disk = ${jsonencode(f.actions.resources.disk)}
%{ endif ~}


[fleets.options]
capacity = ${jsonencode(f.capacity)}
%{ if f.machine_class != null ~}
machine_class = ${jsonencode(f.machine_class)}
%{ endif ~}
%{ if f.fallback != null ~}
[fleets.options.fallback]
retry_spot_after = ${jsonencode(f.fallback.retry_spot_after)}
drain_on_demand_first = ${f.fallback.drain_on_demand_first}
%{ endif ~}
%{ for w in f.scheduled_minimum ~}

[[fleets.scheduled_minimum]]
instances = ${w.instances}
days = ${jsonencode(w.days)}
start = ${jsonencode(w.start)}
end = ${jsonencode(w.end)}
time_zone = ${jsonencode(w.time_zone)}
%{ endfor ~}
%{ endfor }

[execution]
input_links = ${jsonencode(gang_settings.input_links)}
%{ if network_granted ~}

[execution.egress]
protected_networks = ${jsonencode(protected_networks)}
dns_servers = ${jsonencode(execution_egress.dns_servers)}
setup_timeout = ${jsonencode(execution_egress.setup_timeout)}
%{ endif ~}

[provisioner.aws]
region = ${jsonencode(region)}
scratch_mount_point = ${jsonencode(scratch_mount_point)}
fleet_tag_key = ${jsonencode(fleet_tag_key)}
%{ if events_queue_url != null ~}
events_queue_url = ${jsonencode(events_queue_url)}
%{ endif ~}

[provisioner.aws.workload_token]
audience = ${jsonencode(workload_token_audience)}

[cache.s3]
region = ${jsonencode(region)}
bucket = ${jsonencode(cache_bucket_name)}

[signer.kms]
region = ${jsonencode(region)}
key_id = ${jsonencode(ca_key_alias)}

%{ if database_engine != "sqlite" ~}

[server.http2]
shutdown_grace = ${jsonencode("${shutdown_grace_seconds}s")}
%{ endif ~}

%{ if database_engine == "dynamodb" ~}
[database.dynamodb]
table = ${jsonencode(database_table_name)}
region = ${jsonencode(region)}
%{ else ~}
%{ if database_engine == "postgres" ~}
[database.postgres]
host = ${jsonencode(database_postgres.host)}
port = ${jsonencode(database_postgres.port)}
database = ${jsonencode(database_postgres.database)}
user = ${jsonencode(database_postgres.user)}
password_file = ${jsonencode("/etc/gang/secrets/database-password")}
%{ if database_postgres.ca_file != null ~}
ca_file = ${jsonencode(database_postgres.ca_file)}
%{ endif ~}
%{ else ~}
[database.sqlite]
# The controller keeps its state under this path.
path = "/var/lib/gang/gang.db"
%{ endif ~}
%{ endif ~}

[sandbox.bwrap]
root = "/etc/gang/action-rootfs"
%{ if network_granted ~}
[sandbox.bwrap.egress]
%{ endif ~}

[limits.cgroup]

[server]
trust_domain = ${jsonencode(trust_domain)}
# Workers trust this deployment's signer as their CA.
ca_pin = "signer"
%{ if endpoint_trust != null ~}
# A load balancer presents a publicly trusted certificate for endpoint, so clients use their system roots.
endpoint_trust = ${jsonencode(endpoint_trust)}
%{ endif ~}
%{ if standby_routability_delay_seconds > 0 ~}
standby_routability_delay = ${jsonencode("${standby_routability_delay_seconds}s")}
%{ endif }
%{ if leadership_renew_interval_seconds != null ~}
[server.leadership]
renew_interval = ${jsonencode("${leadership_renew_interval_seconds}s")}
call_timeout = ${jsonencode("${leadership_call_timeout_seconds}s")}

%{ endif ~}
%{ if proxy_protocol_mode != "off" ~}
[server.proxy_protocol]
public = ${jsonencode(proxy_protocol_mode)}
worker = ${jsonencode(proxy_protocol_mode)}
health = ${jsonencode(proxy_protocol_mode)}
trusted_cidrs = ${jsonencode(proxy_trusted_cidrs)}

%{ endif ~}
[authentication.clients.token]
providers = ${jsonencode(client_token_providers)}

[authentication.workers.mtls]
provider = "aws-workers"

[identity.providers.aws-workers.oidc]
issuer_url = ${jsonencode(issuer_url)}
audience = ${jsonencode(workload_token_audience)}
# The AWS worker identity is the STS subject.
principal_claim = "sub"
required_claims = { sub = ${jsonencode(worker_role_arn)} }${extra_config_toml != "" ? "\n\n${chomp(extra_config_toml)}" : ""}
